
digraph ER {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.8"];
  node [shape=plain, fontname="Arial"];
  edge [color="#64748b", penwidth=1.2, fontname="Arial", fontsize=9];
  departments [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#eff6ff">
  <TR><TD><B>DEPARTMENTS</B></TD></TR>
  <TR><TD ALIGN="LEFT">PK dept_id</TD></TR><TR><TD ALIGN="LEFT">UQ dept_code</TD></TR><TR><TD ALIGN="LEFT">UQ dept_name</TD></TR><TR><TD ALIGN="LEFT">location</TD></TR></TABLE>>];
  students [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f0fdf4">
  <TR><TD><B>STUDENTS</B></TD></TR>
  <TR><TD ALIGN="LEFT">PK student_id</TD></TR><TR><TD ALIGN="LEFT">UQ enrollment_no</TD></TR><TR><TD ALIGN="LEFT">first_name, last_name</TD></TR><TR><TD ALIGN="LEFT">UQ email</TD></TR><TR><TD ALIGN="LEFT">FK dept_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
  faculty [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#fff7ed">
  <TR><TD><B>FACULTY</B></TD></TR>
  <TR><TD ALIGN="LEFT">PK faculty_id</TD></TR><TR><TD ALIGN="LEFT">faculty_name</TD></TR><TR><TD ALIGN="LEFT">UQ email</TD></TR><TR><TD ALIGN="LEFT">FK dept_id</TD></TR><TR><TD ALIGN="LEFT">salary</TD></TR></TABLE>>];
  courses [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#faf5ff">
  <TR><TD><B>COURSES</B></TD></TR>
  <TR><TD ALIGN="LEFT">PK course_id</TD></TR><TR><TD ALIGN="LEFT">UQ course_code</TD></TR><TR><TD ALIGN="LEFT">course_name</TD></TR><TR><TD ALIGN="LEFT">credits</TD></TR><TR><TD ALIGN="LEFT">FK dept_id</TD></TR></TABLE>>];
  enrollments [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#ecfeff">
  <TR><TD><B>ENROLLMENTS</B></TD></TR>
  <TR><TD ALIGN="LEFT">PK enrollment_id</TD></TR><TR><TD ALIGN="LEFT">FK student_id</TD></TR><TR><TD ALIGN="LEFT">FK course_id</TD></TR><TR><TD ALIGN="LEFT">semester_no</TD></TR><TR><TD ALIGN="LEFT">academic_year</TD></TR></TABLE>>];
  results [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#fef2f2">
  <TR><TD><B>RESULTS</B></TD></TR>
  <TR><TD ALIGN="LEFT">PK result_id</TD></TR><TR><TD ALIGN="LEFT">UQ/FK enrollment_id</TD></TR><TR><TD ALIGN="LEFT">marks</TD></TR><TR><TD ALIGN="LEFT">grade</TD></TR><TR><TD ALIGN="LEFT">result_status</TD></TR></TABLE>>];
  course_faculty [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#f8fafc">
  <TR><TD><B>COURSE_FACULTY</B></TD></TR><TR><TD ALIGN="LEFT">PK/FK course_id</TD></TR><TR><TD ALIGN="LEFT">PK/FK faculty_id</TD></TR></TABLE>>];
  departments -> students [label="1 : N"];
  departments -> faculty [label="1 : N"];
  departments -> courses [label="1 : N"];
  students -> enrollments [label="1 : N"];
  courses -> enrollments [label="1 : N"];
  enrollments -> results [label="1 : 1"];
  faculty -> course_faculty [label="1 : N"];
  courses -> course_faculty [label="1 : N"];
}
